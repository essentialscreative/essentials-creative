{
  "name": "essentials-creative-testing",
  "version": "1.0.0",
  "description": "Testing suite for Essentials Creative website - includes link checking, performance auditing, and comprehensive quality assurance tools",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:links && npm run test:performance",
    "test:links": "node link-checker.js",
    "test:performance": "node performance-test.js",
    "test:all": "npm run test:links && npm run test:performance",
    "start:server": "cd .. && python3 -m http.server 8000",
    "test:full": "npm run start:server & sleep 3 && npm run test:all; kill $!",
    "report": "open reports/performance-report.html && open reports/link-check-report.json",
    "clean": "rm -rf reports/*.json reports/*.html",
    "setup": "npm install && mkdir -p reports"
  },
  "keywords": [
    "testing",
    "quality-assurance",
    "lighthouse",
    "performance",
    "accessibility",
    "link-checking",
    "website-testing"
  ],
  "author": "Essentials Creative",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "chrome-launcher": "^0.15.2",
    "lighthouse": "^10.4.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/essentialscreative/website"
  },
  "bugs": {
    "url": "https://github.com/essentialscreative/website/issues"
  },
  "homepage": "https://essentialscreative.com"
}